# Copy this file to .env and fill in only what you need, or edit the values in
# Settings › Features › Options › Secrets (.env), which lists these names.
# Nothing here is needed for search. A feature whose values are missing shows
# as misconfigured on Settings › Status and the rest keeps working.
# See docs/configuration.md.

# --- Planning Center (only needed if role=logger and provider=planning-center) ---
PLANNING_CENTER_APP_ID=
PLANNING_CENTER_SECRET=

# --- Firestore (only needed if storageBackend=firestore) ---
FIRESTORE_PROJECT_ID=
# Logger machine only — reader machines don't need this at all.
FIRESTORE_SERVICE_ACCOUNT_KEY_PATH=

# --- SFTP (only needed if storageBackend=sftp — self-hosted alternate) ---
SFTP_HOST=
SFTP_USERNAME=
SFTP_PRIVATE_KEY_PATH=
SFTP_KNOWN_HOST_FINGERPRINT=

# --- Day summary by email (only needed if reportModule.enabled and deliveryBackend=email) ---
# The church's own mail server. Port 465 is implicit TLS; 587 upgrades with
# STARTTLS. Refrain won't send a password over a connection that isn't encrypted.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Service feed (only needed if serviceFeedModule.enabled) ---
# The key your announcement server issued for this console. One per console.
SERVICE_FEED_TOKEN=
